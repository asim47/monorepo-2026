# Copy to .env or .env.dev and fill. Never commit .env or .env.dev with real secrets.

# Backend API URL (when USE_MOCK_API=false in src/constants/api_keys.ts)
EXPO_PUBLIC_BACKEND_URL=

# Google Maps
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=

# Google OAuth (Sign-In)
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_IOS_CLIENT_ID=

# App store URLs (optional)
EXPO_PUBLIC_IOS_STORE_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=

# Do not put real tokens here. These are only if needed for build-time tooling; prefer backend for secrets.
EXPO_PUBLIC_SLACK_BOT_TOKEN=
EXPO_PUBLIC_SLACK_CHANNEL_ID=
NPM_TOKEN_GOOGLE_SIGN_IN=
